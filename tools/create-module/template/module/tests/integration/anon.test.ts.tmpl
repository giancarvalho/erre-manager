// Anonymous routes answer without a session and are limited to the community in the path.
import { createModuleHarness, type RoleFixture } from '@erre/core/testing';
import { afterAll, beforeAll, describe, expect, inject, it } from 'vitest';

import moduleApi from '../../api';

const h = createModuleHarness({ urls: inject('db'), modules: [moduleApi] });
let fx: RoleFixture;
beforeAll(async () => {
  fx = await h.fixture();
});
afterAll(() => h.close());

describe('anonymous routes', () => {
  it('answer with no session', async () => {
    const res = await h.req(null, 'GET', `/v1/__id__/anon/c/${fx.communityId}/ping`);
    expect(res.status).toBe(200);
    expect(await res.json()).toEqual({ ok: true });
  });
});
