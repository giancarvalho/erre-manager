PORT=3000
LOG_LEVEL=info
# erre_app role (see packages/db/.env.example and `pnpm --filter @erre/db db:bootstrap`)
DATABASE_URL=postgres://erre_app:erre_app@localhost:5432/erre
PUBLIC_API_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-de-32-caracteres-ou-mais
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application).
# Authorized redirect URI: ${PUBLIC_API_URL}/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TRUSTED_ORIGINS=http://localhost:8081,erre://
