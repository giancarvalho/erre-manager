# URL da API usada pelo app (Sprint 5 em diante).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Endereço público do app web: links compartilhados e a imagem de compartilhamento (og:image) absoluta.
EXPO_PUBLIC_WEB_URL=

# Só no build web de produção, para os links universais (.well-known). Vazio = arquivo não é gerado.
# Team ID da Apple que assina o app iOS.
APPLE_TEAM_ID=
# SHA-256 dos certificados que assinam o app Android, separados por vírgula ("AA:BB:...").
ANDROID_CERT_SHA256=
