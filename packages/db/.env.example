# Local/dev only (docker compose). Production values are set by a human, never committed.
# Superuser connection, used only by `db:bootstrap` and by tests to create disposable databases.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/erre
# Runs migrations (owner of the tables).
DATABASE_MIGRATOR_URL=postgres://erre_migrator:erre_migrator@localhost:5432/erre
# Role passwords set by `db:bootstrap`. On localhost they default to the role name.
ERRE_MIGRATOR_PASSWORD=erre_migrator
ERRE_APP_PASSWORD=erre_app
ERRE_JOBS_PASSWORD=erre_jobs
